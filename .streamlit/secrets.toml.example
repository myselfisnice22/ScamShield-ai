# ScamShield AI - Clerk sign-in settings for the Streamlit website.
#
# 1. Copy this file to .streamlit/secrets.toml  (that file is in .gitignore -
#    NEVER commit it). On Streamlit Community Cloud, paste the same text into
#    your app's Settings -> Secrets instead.
# 2. In the Clerk dashboard: Configure -> OAuth applications -> Add.
#    Redirect URI (local):  http://localhost:8501/oauth2callback
#    Redirect URI (cloud):  https://YOUR-APP.streamlit.app/oauth2callback
#    Scopes: openid, profile, email
# 3. Copy the Client ID, Client Secret and Discovery URL below.
#
# If this file is missing, ScamShield runs without sign-in (as before).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random text. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE-WITH-A-LONG-RANDOM-STRING"

[auth.clerk]
client_id = "REPLACE-WITH-CLERK-OAUTH-CLIENT-ID"
client_secret = "REPLACE-WITH-CLERK-OAUTH-CLIENT-SECRET"
# Your Clerk "Discovery URL", e.g.
# https://your-app-name.clerk.accounts.dev/.well-known/openid-configuration
server_metadata_url = "https://YOUR-CLERK-DOMAIN/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email", prompt = "" }

# OPTIONAL - lets signed-in users delete their account (Settings tab).
# Clerk dashboard -> Configure -> API keys -> Secret keys (starts with sk_).
# This key has full control of your Clerk app: keep it secret.
# [clerk_admin]
# secret_key = "sk_test_REPLACE-ME"
